<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>formatthias</ToolCommandName>
    <PackageId>dotnet-formatthias</PackageId>
    <Version>1.0.0</Version>
    <Description>Conservative, configurable Roslyn C# organizer and formatter.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ForMatthias.Workspaces/ForMatthias.Workspaces.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
